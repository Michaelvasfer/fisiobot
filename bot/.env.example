# === OpenAI ===
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# === Meta WhatsApp Cloud API ===
# Deja estas dos variables VACÍAS para probar en modo simulación (sin llamar a Meta).
# Token de acceso permanente (System User) o temporal de pruebas
WHATSAPP_TOKEN=
# ID del número de teléfono (Phone Number ID) desde Meta Developers.
# Fisiobot usa el número 953838656 (KaminarFisio). El 928742228 es de
# Kaminar Med, lo usa el OTRO bot ("agente whatsapp"): nunca va aquí.
WHATSAPP_PHONE_NUMBER_ID=
# Número que ESTE bot debe tener conectado (solo dígitos, con código de país).
# Al arrancar, el bot le pregunta a Meta qué número tienen las credenciales y
# avisa en consola si no coincide (anti-cruce con el bot de Kaminar Med).
WHATSAPP_NUMERO_ESPERADO=51953838656
# Texto secreto que tú defines para verificar el webhook (el mismo que configures en Meta)
WEBHOOK_VERIFY_TOKEN=mi_token_secreto_123

# === Recepción ===
# Número de WhatsApp de recepción en formato internacional sin "+" (ej. 51999999999)
RECEPCION_WHATSAPP=

# === Servidor ===
# 3101 para no chocar con el dashboard Next.js (:3000) ni la landing (:3001)
PORT=3101

# Chat de prueba del navegador: "true" en local, "false" en producción
HABILITAR_CHAT_WEB=true

# === Modo de agenda: "manual" (cupos en config/clinica.json) o "automatico" ===
# MODO_AGENDA=automatico conecta con KaminarFisio (fisio.kaminar.pe), el sistema
# de agenda del centro de fisioterapia: el bot consulta disponibilidad y
# registra/cancela citas ahí via FISIO_API_URL / FISIO_API_TOKEN.
#
# ADVERTENCIA: NO apuntes FISIO_API_URL a kaminar.pe — ese es Kaminar Med, el
# sistema de OTRO consultorio, con su propio bot ("agente whatsapp") y su propio
# número de WhatsApp. Fisiobot usa únicamente fisio.kaminar.pe y su propio
# número (WHATSAPP_PHONE_NUMBER_ID). El bot se niega a arrancar en modo
# automático si la URL apunta a otro host.
MODO_AGENDA=manual
# URL base del endpoint del bot en KaminarFisio (sin espacios). Ojo: con la
# extensión .php, tal como queda publicado el archivo en el servidor — la ruta
# sin extensión (/api/bot-agenda) no existe en KaminarFisio y redirige al login.
FISIO_API_URL=https://fisio.kaminar.pe/api/bot-agenda.php
# Token compartido que KaminarFisio valida en el header x-bot-token:
FISIO_API_TOKEN=

# Minutos que un horario queda bloqueado por una cita pendiente de confirmar;
# pasado ese plazo sin confirmación, el cupo se libera y el bot vuelve a ofrecerlo
RESERVA_TTL_MINUTOS=120

# Minutos de antelación mínima para ofrecer una hora del día de hoy.
# Con 120, si el paciente escribe a las 9:00 a. m. no se le ofrece nada antes de las 11:00 a. m.
ANTELACION_MINUTOS=120

# Contraseña del panel /admin (usuario: admin)
ADMIN_PASSWORD=cambia-esto

# Notificaciones push del panel (PWA) — genera con: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
